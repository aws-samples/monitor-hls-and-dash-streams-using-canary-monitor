{
  "x": 0,
  "y": 0,
  "height": {{dashboardconfig['metric']['height']}},
  "width": {{dashboardconfig['metric']['width']}},
  "type": "metric",
  "properties": {
    "metrics": [
      {% set ns = namespace(count = 0) %}
      {% for endpoint in renderinfo['endpoints'] %}
        {% if ns.count > 0 %}, {% endif %}[ "CanaryMonitor", "Latency", "Origin", "{{renderinfo['origin']}}", "Type", "{{renderinfo['type']}}", "Endpoint", "{{endpoint['endpoint']}}", "Technology", "{{endpoint['technology']}}", "Rendition", "multi", "RequestType", "manifest", "Workload", "{{renderinfo['workload']}}" ]{% set ns.count = ns.count + 1 %}
        {% if endpoint['technology'] == 'hls' %}
          {% for rendition in endpoint['renditions'] %}
            {% if ns.count > 0 %}, {% endif %}[ "CanaryMonitor", "Latency", "Origin", "{{renderinfo['origin']}}", "Type", "{{renderinfo['type']}}", "Endpoint", "{{endpoint['endpoint']}}", "Technology", "{{endpoint['technology']}}", "Rendition", "{{rendition}}", "RequestType", "manifest", "Workload", "{{renderinfo['workload']}}" ]{% set ns.count = ns.count + 1 %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    ],
    "view": "timeSeries",
    "stacked": false,
    "region": "{{dashboardconfig['region']}}",
    "stat": "Maximum",
    "period": 60,
    "title": "Manifest Latency [msec] (max)",
    "yAxis": {
      "left": {
        "showUnits": false,
        "label": "",
        "min": 0
      },
      "right": {
        "showUnits": false
      }
    },
    "legend": {
      "position": "bottom"
    },
    "annotations": {
      "horizontal": [
        {
          "label": "Threshold",
          "value": 1000,
          "fill": "above"
        }
      ]
    },
    "liveData": true
  }
}
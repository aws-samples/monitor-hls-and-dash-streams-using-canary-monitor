{
  "x": 0,
  "y": 0,
  "height": {{dashboardconfig['metric']['height']}},
  "width": {{dashboardconfig['metric']['width']}},
  "type": "metric",
  "properties": {
    "metrics": [
      {% set ns = namespace(count = 0) %}
      {% for endpoint in renderinfo['endpoints'] %}
        {% if ns.count > 0 %}, {% endif %}[ "CanaryMonitor", "PdtDelta", "Origin", "{{renderinfo['origin']}}", "Type", "{{renderinfo['type']}}", "Endpoint", "{{endpoint['endpoint']}}", "Technology", "{{endpoint['technology']}}", "Workload", "{{renderinfo['workload']}}" ]{% set ns.count = ns.count + 1 %}
      {% endfor %}
    ],
    "view": "timeSeries",
    "stacked": false,
    "region": "{{dashboardconfig['region']}}",
    "stat": "Minimum",
    "period": 60,
    "title": "PDT Delta [sec] (min)",
    "yAxis": {
      "left": {
        "showUnits": false,
        "label": ""
      },
      "right": {
        "showUnits": false
      }
    },
    "legend": {
      "position": "bottom"
    },
    "annotations": {
      "horizontal": [
        {
          "label": "Threshold",
          "value": -20,
          "fill": "below"
        }
      ]
    },
    "liveData": true
  }
}